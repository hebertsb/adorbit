# Copiar a infraestructura/.env (ignorado por git) y completar. NUNCA subir valores reales.
# Los secretos se piden a quien administra cada recurso, por un canal fuera del repo.

# --- Identidad (Keycloak simulado) ---
EMISOR_JWT=http://localhost:8180/realms/adorbit
N8N_CLIENT_SECRET=secreto-local
N8N_WEBHOOK_TOKEN=token-webhook-local
N8N_ENCRYPTION_KEY=clave-local-n8n-solo-desarrollo

# --- RabbitMQ local ---
RABBITMQ_USUARIO=guest
RABBITMQ_CLAVE=guest

# --- ms-facturacion: DynamoDB en AWS (cuenta de Integrante B) ---
AWS_REGION=us-east-1
FACTURACION_TABLA=AdOrbitFacturacion
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- ms-clientes-crm: MongoDB Atlas ---
# APP_KEY de Laravel: php artisan key:generate --show
CRM_APP_KEY=
CRM_MONGO_DSN=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/?retryWrites=true&w=majority
CRM_MONGO_BD=adorbit_crm

# --- Solo para el perfil "equipo" (servicios de Roly y Hebert) ---
CAMPANAS_URL_BD=
CREATIVIDADES_URL_BD=
CREATIVIDADES_SUPABASE_URL=
CREATIVIDADES_SUPABASE_SERVICE_KEY=
CREATIVIDADES_SUPABASE_BUCKET=piezas-creatividades
IA_URL_BD=
IA_URL_BD_LECTOR_MCP=
IA_GROQ_API_KEY=
IA_GROQ_MODELO=openai/gpt-oss-120b
