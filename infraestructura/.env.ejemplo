# Archivo de ejemplo con variables de entorno para Docker Compose e infraestructura local
# Copiar este archivo a .env (ignorado por git) y colocar los valores reales.

# Base de datos Supabase #1 (ms-campanas)
ADORBIT_CAMPANAS_URL_BD=postgresql://postgres.wzsdqnltypjasnbiwtxi:REEMPLAZAR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Keycloak Local
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
ADORBIT_EMISOR_OIDC=http://localhost:8080/realms/adorbit
ADORBIT_JWKS_URI=http://localhost:8080/realms/adorbit/protocol/openid-connect/certs

# RabbitMQ Local
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
ADORBIT_RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Pasarela API
PORT_PASARELA=8000

