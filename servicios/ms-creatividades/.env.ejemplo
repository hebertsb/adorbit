# Copiar a .env (ignorado por git) y completar los valores reales.

# Mongo Atlas — base adorbit_creatividades (ver base_de_datos/ms-creatividades.mongo.js)
ADORBIT_CREATIVIDADES_URL_BD=mongodb+srv://REEMPLAZAR_USUARIO:REEMPLAZAR_CONTRASENA@REEMPLAZAR_CLUSTER.mongodb.net/adorbit_creatividades

# Keycloak (realm de Roly — confirmar URL real cuando exista)
ADORBIT_CREATIVIDADES_JWKS_URI=http://localhost:8080/realms/adorbit/protocol/openid-connect/certs
ADORBIT_CREATIVIDADES_EMISOR=http://localhost:8080/realms/adorbit
ADORBIT_CREATIVIDADES_AUDIENCIA=ms-creatividades

# RabbitMQ (exchanges/colas de Roly — ver documentacion/03-contratos.md)
ADORBIT_CREATIVIDADES_RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Supabase Storage (piezas) — TODO Hebert: crear el bucket real
ADORBIT_CREATIVIDADES_SUPABASE_URL=https://REEMPLAZAR_PROYECTO.supabase.co
ADORBIT_CREATIVIDADES_SUPABASE_SERVICE_KEY=REEMPLAZAR_SERVICE_ROLE_KEY
ADORBIT_CREATIVIDADES_SUPABASE_BUCKET=piezas-creatividades
