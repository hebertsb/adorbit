# Copiar a .env (ignorado por git) y reemplazar REEMPLAZAR_CONTRASENA por la real
# (te la pasa quien administra el proyecto Supabase, por un canal fuera del repo).
ADORBIT_IA_URL_BD=postgresql://postgres.gbsxuruxkowamugicucb:REEMPLAZAR_CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Conexion SEPARADA para el servidor MCP, atada al rol lector_mcp real — ver
# base_de_datos/ms-ia.postgres.sql. TODO Hebert: crear el usuario LOGIN en Supabase
# (GRANT lector_mcp TO <usuario>; ALTER ROLE <usuario> SET statement_timeout = '5s').
# Mientras no exista, se puede dejar igual a ADORBIT_IA_URL_BD (la app agrega
# SET LOCAL statement_timeout como segunda capa, pero NO reemplaza el rol real).
ADORBIT_IA_URL_BD_LECTOR_MCP=postgresql://postgres.gbsxuruxkowamugicucb:REEMPLAZAR_CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Keycloak (realm de Roly — confirmar URL real cuando exista)
ADORBIT_IA_JWKS_URI=http://localhost:8080/realms/adorbit/protocol/openid-connect/certs
ADORBIT_IA_EMISOR=http://localhost:8080/realms/adorbit
ADORBIT_IA_AUDIENCIA=ms-ia

# RabbitMQ (exchanges/colas de Roly — ver documentacion/03-contratos.md)
ADORBIT_IA_RABBITMQ_URL=amqp://guest:guest@localhost:5672
