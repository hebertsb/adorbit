{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlertaCampana",
  "description": "Publica ms-ia (agente monitor, tarea 5 — todavia no implementado). Consume n8n.",
  "type": "object",
  "required": ["id_evento", "tipo_evento", "version_esquema", "ocurrido_en", "agregado_id", "correlacion_id", "carga"],
  "properties": {
    "id_evento": { "type": "string", "format": "uuid" },
    "tipo_evento": { "const": "AlertaCampana" },
    "version_esquema": { "type": "integer", "const": 1 },
    "ocurrido_en": { "type": "string", "format": "date-time" },
    "agregado_id": { "type": "string", "format": "uuid", "description": "campana_id" },
    "correlacion_id": { "type": "string" },
    "carga": {
      "type": "object",
      "required": ["campana_id", "tipo", "detalle"],
      "properties": {
        "campana_id": { "type": "string", "format": "uuid" },
        "tipo": { "type": "string", "description": "ej. presupuesto_90_porciento, factura_por_vencer" },
        "detalle": { "type": "string" }
      }
    }
  }
}
