{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adorbit/contratos/eventos/FacturaEmitida.schema.json",
  "title": "FacturaEmitida",
  "description": "Se emitio una factura. Publica/emite: ms-facturacion. Consumen: ms-campanas, ms-ia. Sobre estandar en documentacion/03-contratos.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id_evento",
    "tipo_evento",
    "version_esquema",
    "ocurrido_en",
    "agregado_id",
    "correlacion_id",
    "carga"
  ],
  "properties": {
    "id_evento": {
      "type": "string",
      "format": "uuid"
    },
    "tipo_evento": {
      "const": "FacturaEmitida"
    },
    "version_esquema": {
      "const": 1
    },
    "ocurrido_en": {
      "type": "string",
      "format": "date-time"
    },
    "agregado_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlacion_id": {
      "type": "string",
      "maxLength": 100
    },
    "carga": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factura_id",
        "cliente_id",
        "campana_id",
        "total",
        "moneda",
        "fecha_vencimiento"
      ],
      "properties": {
        "factura_id": {
          "type": "string",
          "format": "uuid"
        },
        "cliente_id": {
          "type": "string",
          "format": "uuid"
        },
        "campana_id": {
          "type": "string",
          "format": "uuid"
        },
        "total": {
          "type": "string",
          "pattern": "^\\d{1,12}(\\.\\d{1,2})?$",
          "description": "Decimal como texto, 2 decimales maximo"
        },
        "moneda": {
          "type": "string",
          "enum": [
            "BOB",
            "USD"
          ]
        },
        "fecha_vencimiento": {
          "type": "string",
          "format": "date"
        },
        "saga_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
