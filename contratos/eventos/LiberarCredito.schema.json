{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adorbit/contratos/eventos/LiberarCredito.schema.json",
  "title": "LiberarCredito",
  "description": "Comando SAGA compensacion del paso 2: liberar la reserva de credito. Publica/emite: ms-campanas (cola saga.crm). Consumen: ms-clientes-crm. Sobre estandar en documentacion/03-contratos.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id_evento",
    "tipo_evento",
    "version_esquema",
    "ocurrido_en",
    "agregado_id",
    "correlacion_id",
    "carga"
  ],
  "properties": {
    "id_evento": {
      "type": "string",
      "format": "uuid"
    },
    "tipo_evento": {
      "const": "LiberarCredito"
    },
    "version_esquema": {
      "const": 1
    },
    "ocurrido_en": {
      "type": "string",
      "format": "date-time"
    },
    "agregado_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlacion_id": {
      "type": "string",
      "maxLength": 100
    },
    "carga": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "saga_id",
        "clave_comando",
        "cliente_id",
        "campana_id",
        "monto",
        "moneda"
      ],
      "properties": {
        "saga_id": {
          "type": "string",
          "format": "uuid"
        },
        "clave_comando": {
          "type": "string",
          "pattern": "^[0-9a-fA-F-]{36}:[1-9]:(accion|compensacion)$",
          "description": "sagaId:orden:tipo"
        },
        "cliente_id": {
          "type": "string",
          "format": "uuid"
        },
        "campana_id": {
          "type": "string",
          "format": "uuid"
        },
        "monto": {
          "type": "string",
          "pattern": "^\\d{1,12}(\\.\\d{1,2})?$",
          "description": "Decimal como texto, 2 decimales maximo"
        },
        "moneda": {
          "type": "string",
          "enum": [
            "BOB",
            "USD"
          ]
        }
      }
    }
  }
}
