{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiezaSubida",
  "description": "Publica ms-creatividades cuando una pieza queda con un archivo adjunto (consume ms-ia, agente de marca).",
  "type": "object",
  "required": ["id_evento", "tipo_evento", "version_esquema", "ocurrido_en", "agregado_id", "correlacion_id", "carga"],
  "properties": {
    "id_evento": { "type": "string", "format": "uuid" },
    "tipo_evento": { "const": "PiezaSubida" },
    "version_esquema": { "type": "integer", "const": 1 },
    "ocurrido_en": { "type": "string", "format": "date-time" },
    "agregado_id": { "type": "string", "format": "uuid", "description": "pieza_id" },
    "correlacion_id": { "type": "string", "format": "uuid" },
    "carga": {
      "type": "object",
      "required": ["pieza_id", "campana_id", "archivo.ruta"],
      "properties": {
        "pieza_id": { "type": "string", "format": "uuid" },
        "campana_id": { "type": "string", "format": "uuid" },
        "archivo.ruta": { "type": "string" },
        "huella_imagen": {
          "type": ["string", "null"],
          "description": "Hash calculado por quien sube el archivo; null si no se proveyo (el servicio nunca ve los bytes)."
        }
      }
    }
  }
}
