{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PiezaAprobada",
  "description": "Publica ms-creatividades cuando un revisor aprueba una pieza.",
  "type": "object",
  "required": ["id_evento", "tipo_evento", "version_esquema", "ocurrido_en", "agregado_id", "correlacion_id", "carga"],
  "properties": {
    "id_evento": { "type": "string", "format": "uuid" },
    "tipo_evento": { "const": "PiezaAprobada" },
    "version_esquema": { "type": "integer", "const": 1 },
    "ocurrido_en": { "type": "string", "format": "date-time" },
    "agregado_id": { "type": "string", "format": "uuid", "description": "pieza_id" },
    "correlacion_id": { "type": "string", "format": "uuid" },
    "carga": {
      "type": "object",
      "required": ["pieza_id", "campana_id"],
      "properties": {
        "pieza_id": { "type": "string", "format": "uuid" },
        "campana_id": { "type": "string", "format": "uuid" },
        "archivo.ruta": { "type": ["string", "null"] }
      }
    }
  }
}
